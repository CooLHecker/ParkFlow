{
  "name": "parkflow-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express + MySQL (Aiven) backend for the ParkFlow parking management system",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:seed:demo": "node scripts/seed.js --demo",
    "db:reset": "node scripts/migrate.js --reset",
    "test": "node --test test/*.test.js"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mysql2": "^3.11.3"
  }
}
