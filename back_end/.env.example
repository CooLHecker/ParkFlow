# ---- Aiven for MySQL connection -------------------------------------
# Aiven Console -> your MySQL service -> Overview -> "Connection information"
# Option A: paste the "Service URI" (recommended)
DATABASE_URL=mysql://avnadmin:YOUR_PASSWORD@YOUR-SERVICE-your-project.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

# Option B: individual fields (used only if DATABASE_URL is empty)
# DB_HOST=
# DB_PORT=
# DB_USER=avnadmin
# DB_PASSWORD=
# DB_NAME=defaultdb

# ---- TLS (Aiven requires TLS) ---------------------------------------
# Download "CA certificate" (ca.pem) from the same Aiven page and either:
DB_SSL_CA=./certs/ca.pem
# ...or paste the PEM text into one variable (handy on Render/Railway/Vercel):
# DB_SSL_CA_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Set to false ONLY for a local, non-TLS MySQL:
# DB_SSL=false

# ---- App -------------------------------------------------------------
PORT=4000
# Frontend origin(s), comma-separated, no trailing slash. On Vercel set this to your frontend URL,
# e.g. https://parkflow.vercel.app  (leave unset or '*' to allow any origin)
CORS_ORIGIN=http://localhost:3000
DB_POOL_SIZE=5
